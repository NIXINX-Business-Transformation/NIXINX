# Set in Vercel Project > Settings > Environment Variables.
# Keep these server-side. NEVER prefix private values with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Generate a long random secret used to hash request fingerprints for anti-abuse limits.
LEADS_HASH_SECRET=
# Optional: verified public mailbox for inquiries, only shown if configured.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional Cloudflare Turnstile protection: set BOTH for production if enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional internal support notification; leave disabled until verified in Sandbox.
# Server-only; never NEXT_PUBLIC_. Use an authorized verified Resend sender.
SUPPORT_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_NOTIFY_EMAIL=
